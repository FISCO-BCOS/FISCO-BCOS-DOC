##完整代码示例
#include <bcos-cpp-sdk/SdkFactory.h>
#include <bcos-utilities/Common.h>
#include <iostream>
#include <memory>

using namespace bcos;
using namespace bcos::cppsdk;

int main(int argc, char** argv)
{
    // 1. 解析命令行参数
    if (argc < 2)
    {
        std::cout << "Usage: ./rpc_test <config> [groupID]" << std::endl;
        return -1;
    }
    std::string configFile = argv[1];
    std::string groupID = (argc >= 3) ? argv[2] : "group0";

    // 2. 初始化 SDK
    auto factory = std::make_shared<SdkFactory>();
    auto sdk = factory->buildSdk(configFile);
    sdk->start();

    // 3. 获取 JSON-RPC 客户端
    auto jsonRpc = sdk->jsonRpc();

    // 4. 调用 getBlockNumber
    try
    {
        auto response = jsonRpc->getBlockNumber(groupID);
        std::cout << LOG_DESC(" [rpc_test] getBlockNumber success")
                  << LOG_KV("group", groupID)
                  << LOG_KV("blockNumber", response["result"].asInt64())
                  << std::endl;
    }
    catch (const std::exception& e)
    {
        std::cout << LOG_DESC(" [rpc_test] getBlockNumber failed")
                  << LOG_KV("error", e.what()) << std::endl;
    }

    // 5. 释放资源
    sdk->stop();
    return 0;
}

